#!/usr/bin/env bash
set -eo pipefail

# This hook is called after the plugin is added to asdf and initializes the pinned php-build submodule.

PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PHP_BUILD_DIR="$PLUGIN_DIR/vendor/php-build"

echo "Initializing php-build..."

# Check if vendor/php-build already exists and has content
if [ -f "$PHP_BUILD_DIR/bin/php-build" ]; then
  echo "✓ php-build already initialized at $(git -C "$PHP_BUILD_DIR" rev-parse HEAD 2>/dev/null || echo unknown revision)"
  exit 0
fi

# Create vendor directory if it doesn't exist
mkdir -p "$PLUGIN_DIR/vendor"

# Try to initialize submodule if we're in a git repository
if { [ -d "$PLUGIN_DIR/.git" ] || [ -f "$PLUGIN_DIR/.git" ]; } && git -C "$PLUGIN_DIR" submodule update --init --recursive vendor/php-build; then
  if [ -f "$PHP_BUILD_DIR/bin/php-build" ]; then
    PHP_BUILD_REVISION=$(git -C "$PHP_BUILD_DIR" rev-parse HEAD)
    echo "✓ php-build submodule initialized at $PHP_BUILD_REVISION"
  fi
fi

if [ ! -f "$PHP_BUILD_DIR/bin/php-build" ]; then
  echo "✗ Failed to initialize the pinned php-build submodule at $PHP_BUILD_DIR"
  echo "Run 'git submodule update --init --recursive vendor/php-build' from the plugin directory."
  exit 1
fi

# Ensure all bin scripts have executable permissions
echo "Setting executable permissions on bin scripts..."
chmod +x "$PLUGIN_DIR"/bin/*

echo ""
echo "✓ asdf-php plugin setup complete!"
echo ""
echo "You can now install PHP versions with:"
echo "  asdf install php <version>"
