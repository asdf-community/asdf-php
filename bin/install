#!/usr/bin/env python3
"""Install a PHP version through the bundled php-build checkout."""

from pathlib import Path
import sys

PLUGIN_DIR = Path(__file__).resolve().parent.parent
if sys.version_info < (3, 9):
    print("asdf-php: bin/install requires Python 3.9 or newer", file=sys.stderr)
    raise SystemExit(1)
sys.path.insert(0, str(PLUGIN_DIR / "lib"))

from install import main


if __name__ == "__main__":
    if sys.argv[1:] in (["-h"], ["--help"]):
        print("Usage: bin/install\nRequires Python 3.9 or newer.")
        raise SystemExit(0)
    if sys.argv[1:]:
        print("Usage: bin/install", file=sys.stderr)
        raise SystemExit(2)
    raise SystemExit(main(PLUGIN_DIR))
